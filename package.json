{
  "name": "bnc-presentation",
  "productName": "BNC Presentation",
  "version": "0.1.3",
  "description": "Open-source presentation maker with full .pptx support and Nextcloud integration.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "author": "BNC",
  "homepage": "https://presentation.bncplayer.com",
  "repository": { "type": "git", "url": "git+https://github.com/PigeonBoi69/bnc-presentation.git" },
  "bugs": { "url": "https://github.com/PigeonBoi69/bnc-presentation/issues" },
  "desktopName": "bnc-presentation.desktop",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis",
    "dist:linux": "vite build && electron-builder --linux deb AppImage",
    "dist:mac": "vite build && electron-builder --mac zip --arm64 --x64",
    "version:bump": "tsx tools/bump-version.ts",
    "build:linux": "powershell -ExecutionPolicy Bypass -File tools/build-linux.ps1",
    "smoke:linux": "powershell -ExecutionPolicy Bypass -File tools/linux-smoke.ps1",
    "build:mac": "powershell -ExecutionPolicy Bypass -File tools/build-mac.ps1",
    "check:mac": "powershell -ExecutionPolicy Bypass -File tools/mac-check.ps1",
    "icons": "node tools/make-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "lucide": "^1.53.0",
    "png-to-ico": "^3.0.2",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.10.5",
    "prosemirror-view": "^1.41.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.bncplayer.bncpresentation",
    "productName": "BNC Presentation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "executableName": "bnc-presentation",
      "syncDesktopName": true,
      "category": "Office",
      "synopsis": "Open-source presentation maker with full .pptx support",
      "description": "BNC Presentation is an open-source presentation maker in the same family as BNC Docs and BNC Sheets. It opens and saves .pptx files, has its own .bncpres format, and works with Nextcloud.",
      "maintainer": "BNC <noreply@bncplayer.com>",
      "artifactName": "BNC-Presentation-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "bnc-presentation",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "libcups2t64 | libcups2"
      ],
      "recommends": [
        "fonts-crosextra-carlito",
        "fonts-liberation",
        "fonts-crosextra-caladea"
      ]
    },
    "afterPack": "tools/mac-adhoc-sign.cjs",
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0",
      "artifactName": "BNC-Presentation-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDisplayName": "BNC Presentation",
        "NSHumanReadableCopyright": "MIT License"
      }
    },
    "fileAssociations": [
      {
        "ext": "bncpres",
        "name": "BNC Presentation",
        "description": "BNC Presentation",
        "icon": "build/icon.ico",
        "mimeType": "application/x-bncpres",
        "role": "Editor"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint presentation",
        "description": "PowerPoint presentation",
        "icon": "build/icon.ico",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "role": "Editor"
      }
    ]
  }
}
